#!/bin/bash
#SBATCH -J dirt-render
#SBATCH -o render.log
#SBATCH -t 2-00:00:00
#SBATCH -p corralextra
#SBATCH -N 1 -n 1
#SBATCH -A A2CPS

set -xeu
a2cps=/corral-secure/projects/A2CPS
derivatives=${a2cps}/products/mris
# login-node build (compute has no network): apptainer build "${SIF}" docker://psadil/dirt:manage
# SIF=${SCRATCH}/dirt/dirt-manage.sif
SIF="docker://psadil/dirt:manage"
CATALOG=/tmp/a2cps.duckdb # node-local; /tmp is bound by apptainer already
DBDIR=/tmp/dirtdb         # ditto — no explicit bind needed
MEDIADIR=/tmp/dirtmedia   # rendered images land here as files (see storage.py)
PLAN=a2cps.toml           # review plan, staged into the submit dir like .env (from the repo's tools/)
OUT=${SCRATCH}/dirt/db
OUTMEDIA=${SCRATCH}/dirt/media
TEMPLATEFLOW=${SCRATCH}/dirt/templateflow # persistent caches, shared login↔compute (see prewarm below)
ROIS=${SCRATCH}/dirt/rois                 # ditto

# Two login-node modes, each needing the network a compute node lacks:
#   ./write_imgs prewarm   before sbatch — fills the ROI/TemplateFlow caches
#   ./write_imgs push      after the job — uploads its outputs to the deployment
# In push mode the job's copied-out db/ and media/ stand in for the node-local
# ones, so the same container invocation serves both.
MODE=${1:-}
if [[ "${MODE}" == push ]]; then DBDIR=${OUT}; MEDIADIR=${OUTMEDIA}; fi

mkdir -p "${DBDIR}" "${MEDIADIR}" "${OUT}" "${OUTMEDIA}" "${TEMPLATEFLOW}" "${ROIS}"
rm -f "${CATALOG}" "${CATALOG}.wal"
# .env (staged in the submit dir, chmod 600) uses `export`, which --env-file can't
# read, so it is sourced — with xtrace off, or every secret lands in render.log.
# It holds DJANGO_SECRET_KEY, and for push mode DIRT_PUSH_URL (https://<host>/dirt),
# DIRT_PUSH_USER and DIRT_PUSH_PASSWORD (an `ingest` account; see create_rater).
{ set +x; } 2>/dev/null
set -a
. ./.env
set +a
set -x

run() {
	{ set +x; } 2>/dev/null # the command line carries secrets; keep it out of the log
	apptainer exec --bind "${a2cps}" --bind "${TEMPLATEFLOW}" --bind "${ROIS}" \
		--bind "${OUT}" --bind "${OUTMEDIA}" \
		--env DB="${DBDIR}/dirt.db" --env MEDIA_ROOT="${MEDIADIR}" \
		--env DJANGO_SECRET_KEY="${DJANGO_SECRET_KEY}" \
		--env TEMPLATEFLOW_HOME="${TEMPLATEFLOW}" --env DIRT_ROI_CACHE="${ROIS}" \
		--env DIRT_PUSH_URL="${DIRT_PUSH_URL:-}" --env DIRT_PUSH_USER="${DIRT_PUSH_USER:-}" \
		--env DIRT_PUSH_PASSWORD="${DIRT_PUSH_PASSWORD:-}" \
		"${SIF}" "$@"
	set -x
}

if [[ "${MODE}" == push ]]; then
	# The staged plan is re-activated first, so the plan that travels last (and
	# ends active on the server) is always this file, not whatever the render job
	# applied: editing a2cps.toml and pushing is enough to change the serving
	# strategy, and a later push cannot quietly revert it.
	run manage plan "${PLAN}"
	# Reconciles by digest: units the server already holds unchanged are skipped,
	# the plan travels first, and the server re-prioritizes afterwards — so this
	# is safe to re-run after a partial failure, and after a later --update render.
	run manage push
	exit 0
fi

# A cold ROI cache needs network (TemplateFlow) plus minutes of registration, which
# the offline compute node can't do: pre-warm on a login node with `./write_imgs prewarm`
# before sbatch. In the job the same command is an instant fail-fast cache check.
run manage build_rois MNI152NLin2009cAsym MNI152NLin6Asym
if [[ "${MODE}" == prewarm ]]; then exit 0; fi

for s in "${derivatives}"/*/fmriprep-v4/*; do
	echo $s
	run bidslake index -i "${s}/fmriprep" --adapter freesurfer --adapter fmriprep \
		--dataset-id fmriprep -o "${CATALOG}" --no-bidsignore
	run bidslake index -i "${s}/fmriprep/sourcedata/freesurfer" --no-bidsignore \
		--adapter freesurfer --adapter fmriprep --dataset-id freesurfer -o "${CATALOG}"
done

# rsync -ha --info=progress2 "${derivatives}"/*/synthstrip/*/synthstrip/ sourcedata/synthstrip/
run bidslake index -i sourcedata/synthstrip --no-bidsignore \
	--adapter freesurfer --adapter fmriprep --dataset-id synthstrip -o "${CATALOG}"

# rsync -ah --info=progress2 "${derivatives}"/*/qsirecon_fsl_dtifit/*/dtifit/multishell/ sourcedata/multishell/
# run bidslake index -i "sourcedata/multishell" --no-bidsignore \
# 	--adapter freesurfer --adapter fmriprep --dataset-id dtifit -o "${CATALOG}"

run manage migrate --no-input
run manage plan "${PLAN}"      # activate before render: render stamps the plan + computes its measures
run manage render "${CATALOG}" # drop --update on a fresh seed
run manage prioritize          # measures → Image.priority, the anomaly_first ordering key
cp -av "${DBDIR}"/. "${OUT}/"
cp -av "${MEDIADIR}"/. "${OUTMEDIA}/"
cp -av "${CATALOG}" "${PWD}"
# Then, from a login node: ./write_imgs push
